{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/daily-digest",
            "schedule": "0 23 * * *"
        },
        {
            "path": "/api/cron/auto-pilot",
            "schedule": "0 */2 * * *"
        }
    ]
}
